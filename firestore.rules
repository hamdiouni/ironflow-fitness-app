rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function ownerFieldMatches(userId) {
      return !('userId' in request.resource.data)
          || request.resource.data.userId == userId;
    }

    // The UID in the path is the source of ownership truth. Every user-owned
    // collection used by FirestorePaths / FirestoreSyncDataSource is covered
    // here, including nutrition targets and sync metadata documents.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /profile/{document=**} {
        allow read, write: if isOwner(userId);
      }

      match /workouts/{workoutId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && ownerFieldMatches(userId);
        allow delete: if isOwner(userId);
      }

      match /programs/{programId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && ownerFieldMatches(userId);
        allow delete: if isOwner(userId);
      }

      match /nutrition/{nutritionDocumentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && ownerFieldMatches(userId);
        allow delete: if isOwner(userId);
      }

      match /body_progress/{entryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && ownerFieldMatches(userId);
        allow delete: if isOwner(userId);
      }

      match /sync_metadata/{metadataId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && ownerFieldMatches(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Shared reference data. The mobile client may read these records, while
    // writes require an Admin SDK/privileged account (admin custom claim).
    match /foods/{foodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
