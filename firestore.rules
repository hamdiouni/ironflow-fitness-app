rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Catalog seeding is an operator task (upload scripts / Admin SDK),
    // never a normal end-user capability. Grant with a Firebase Auth
    // custom claim: { "admin": true }.
    function isAdmin() {
      return isAuthenticated()
          && 'admin' in request.auth.token
          && request.auth.token.admin == true;
    }

    // Flat top-level collections (workouts/programs/nutrition/body_progress)
    // store ownership in a `userId` FIELD written by
    // FirestoreSyncDataSourceImpl, not in the path. These helpers check that
    // field. See docs/architecture/DATABASE_AND_SYNC_AUDIT.md (F-02): the
    // previous rules expected the layout `{collection}/{userId}/**`, which
    // no writer ever produced, so every cloud write was denied.
    function readsOwnDoc() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function writesOwnDoc() {
      return isAuthenticated()
          && request.resource.data.userId is string
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userId.size() > 0
          && request.resource.data.userId.size() <= 128;
    }

    // Bounds field count and optional variable-length fields on client writes
    // to prevent megabyte payload stuffing (BKD-04).
    function isBoundedDoc() {
      return request.resource.data.keys().size() <= 50
          && (!('deletedAt' in request.resource.data)
              || request.resource.data.deletedAt == null
              || (request.resource.data.deletedAt is string
                  && request.resource.data.deletedAt.size() <= 64))
          && (!('name' in request.resource.data)
              || request.resource.data.name == null
              || (request.resource.data.name is string
                  && request.resource.data.name.size() <= 500))
          && (!('notes' in request.resource.data)
              || request.resource.data.notes == null
              || (request.resource.data.notes is string
                  && request.resource.data.notes.size() <= 10000))
          && (!('exercises' in request.resource.data)
              || request.resource.data.exercises == null
              || (request.resource.data.exercises is list
                  && request.resource.data.exercises.size() <= 200))
          && (!('items' in request.resource.data)
              || request.resource.data.items == null
              || (request.resource.data.items is list
                  && request.resource.data.items.size() <= 200));
    }

    function isValidSyncPayload() {
      return writesOwnDoc() && isBoundedDoc();
    }

    // ------------------------------------------------------------------
    // Per-user tree: users/{uid} and its explicitly allowed subcollections.
    // Covers: profile/data (auth), backups/{id} (settings), and read-only
    // ai_usage/{date} (written exclusively by the Cloud Functions AI proxy
    // via Admin SDK so clients cannot reset their own daily quota).
    // ------------------------------------------------------------------
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isBoundedDoc();

      match /profile/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isBoundedDoc();
      }

      match /backups/{backupId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isBoundedDoc();
      }

      match /nutrition/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isBoundedDoc();
      }

      match /consent/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isBoundedDoc();
      }

      match /ai_usage/{dateId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ------------------------------------------------------------------
    // Flat collections written by THE sync engine (Phase 2: the single
    // cloud layout — see FirestoreSyncDataSource). Documents carry a
    // `userId` field; pulls filter `where('userId', == uid)` and page on
    // the server `syncedAt` timestamp. Deletes are tombstone updates
    // (deletedAt field), hence `update` covers them; hard `delete` is
    // kept for the program document and account cleanup.
    // IMPORTANT (BKD-01): `update` requires BOTH `readsOwnDoc()` (existing
    // doc belongs to caller) and `isValidSyncPayload()` (incoming doc still
    // belongs to caller and respects field bounds) to prevent cross-user
    // document hijacking.
    // ------------------------------------------------------------------
    match /workouts/{workoutId} {
      allow read, delete: if readsOwnDoc();
      allow create: if isValidSyncPayload();
      allow update: if readsOwnDoc() && isValidSyncPayload();
    }

    match /programs/{programId} {
      allow read, delete: if readsOwnDoc();
      allow create: if isValidSyncPayload();
      allow update: if readsOwnDoc() && isValidSyncPayload();
    }

    match /nutrition/{logId} {
      allow read, delete: if readsOwnDoc();
      allow create: if isValidSyncPayload();
      allow update: if readsOwnDoc() && isValidSyncPayload();
    }

    match /body_progress/{progressId} {
      allow read, delete: if readsOwnDoc();
      allow create: if isValidSyncPayload();
      allow update: if readsOwnDoc() && isValidSyncPayload();
    }

    // Nutrition targets: singleton document whose ID IS the user id.
    match /nutrition_targets/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSyncPayload();
    }

    // NOTE: the old `sync_metadata` collection (cloud-stored pull
    // cursors) was retired in Phase 2 — cursors are per-device local
    // state now. No rule => denied, as intended.

    // ------------------------------------------------------------------
    // Shared read-only catalogs (seeded by upload scripts/Admin SDK).
    // Publicly readable so catalog screens work pre-login; writes are
    // admin-only so any signed-in user cannot poison shared nutrition or
    // exercise data. User custom foods are local Hive records, not writes
    // to this shared catalog.
    // ------------------------------------------------------------------
    match /foods/{foodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exercises/{exerciseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
